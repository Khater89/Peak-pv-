# Public site URL, used for canonical links, sitemap and Open Graph.
SITE_URL=http://localhost:3000

# Where quote requests are stored: "file" (default) or "supabase".
#  file     -> appends JSON lines to ./data/inquiries.jsonl on the server.
#              Needs a persistent disk (VPS, container with volume). Not for serverless.
#  supabase -> inserts into the `inquiries` table (see supabase/inquiries.sql).
INQUIRY_STORE=file

# Only used when INQUIRY_STORE=supabase. Server-side only — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
